{
  "name": "steam-profile-designer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chrome extension that composes Steam backgrounds, transparent cut-outs and your own images/GIFs into showcase artwork, with a live preview on the real profile page.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --open /mock-profile.html",
    "build": "npm run build:app && npm run build:content && npm run build:helper && npm run build:mock && npm run build:sw",
    "build:app": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build:helper": "vite build --config vite.helper.config.ts",
    "build:mock": "vite build --config vite.mock.config.ts",
    "build:sw": "vite build --config vite.sw.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog": "node scripts/build-catalog.mjs"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
