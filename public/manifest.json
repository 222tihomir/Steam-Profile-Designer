{
  "manifest_version": 3,
  "name": "Steam Profile Designer",
  "short_name": "SPD",
  "version": "1.0.1",
  "description": "Собирает фон Steam, прозрачное окно и вашу картинку или GIF в готовую витрину профиля с живым предпросмотром.",
  "homepage_url": "https://github.com/222tihomir/Steam-Profile-Designer",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Steam Profile Designer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": ["storage", "unlimitedStorage", "tabs"],
  "host_permissions": [
    "https://steamcommunity.com/*",
    "https://*.steamcommunity.com/*",
    "https://*.steamstatic.com/*",
    "https://*.akamaihd.net/*",
    "https://*.steampowered.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/profiles/*",
        "https://steamcommunity.com/id/*",
        "https://steamcommunity.com/my*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://steamcommunity.com/sharedfiles/edititem/*"],
      "js": ["helper.js"],
      "run_at": "document_idle"
    }
  ]
}
